{
  "name": "last-light",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run build:wallet && node scripts/build-game.mjs",
    "verify:browser": "node tests/browser.mjs",
    "verify:rover": "node tests/rover-room.mjs",
    "build:ground-assets": "node scripts/build-ground-assets.mjs",
    "verify:self-play": "node tests/self-play.mjs",
    "build:wallet": "node scripts/build-wallet.mjs",
    "verify:near": "node scripts/verify-near.mjs",
    "build:contract": "node scripts/build-contract.mjs",
    "deploy:testnet": "node scripts/deploy-near.mjs",
