    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "near-api-js": "^7.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0"
  },
