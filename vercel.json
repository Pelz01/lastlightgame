{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "functions": {"api/npc/*.js": {"maxDuration": 60}},
  "headers": [{"source": "/api/npc/:path*", "headers": [{"key": "Cache-Control", "value": "no-store"}]}]
}
